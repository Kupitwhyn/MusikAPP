# Server configuration. Replace every placeholder before deploying.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=https://your-app.example.com
BLOB_READ_WRITE_TOKEN="replace-with-your-vercel-blob-read-write-token"

# Comma-separated exact additional origins. For a physical Android device using the dev server,
# add its browser origin here (for example http://192.168.1.20:3000); update it if the LAN IP changes.
# BETTER_AUTH_TRUSTED_ORIGINS=https://staging.example.com,https://mobile-web.example.com

# Optional. Uncomment and configure only when intentionally bootstrapping a super admin.
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=replace-with-a-unique-password

# Optional origin for a separately hosted mobile web client. Native apps do not use CORS.
# MOBILE_WEB_ORIGIN=https://your-mobile-web.example.com
