# Mobile release builds require the public HTTPS API endpoint.
EXPO_PUBLIC_API_URL=https://your-app.example.com/api/v1

# For local Android emulator development, use:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
# For a physical device, use the computer's LAN IP; both devices must share a network,
# and the computer firewall must allow incoming connections to port 3000.
